# HTTP port the API listens on (default 4000)
PORT=4000
# The only origin allowed by CORS (default http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000
# SQLite database file; use :memory: in tests (default ./data/feed.db)
DATABASE_PATH=./data/feed.db
# 1/true serves fixture data instead of calling external services (default false)
FAKE_EXTERNALS=false
# Cron expression for the daily feed build (default 0 6 * * *)
FEED_CRON=0 6 * * *
# OpenAI API key for the chat LLM (optional)
OPENAI_API_KEY=
# OpenAI model for chat answers (default gpt-5.4-mini)
OPENAI_MODEL=gpt-5.4-mini
# Max completion tokens, reasoning included (default 4096)
OPENAI_MAX_TOKENS=4096
# Local sentence-embedding model, cached under ./data/models (default Xenova/bge-small-en-v1.5).
# The embedder uses CLS pooling and bge's query prefix, so keep a bge model here.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# YouTube Data API key for video fetching (optional)
YOUTUBE_API_KEY=
